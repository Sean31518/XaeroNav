accessWidener v2 named

# RenderType.CompositeState / RenderStateShard.LineStateShard have access flags in their own class files
# that disagree with the declarations in the InnerClasses attribute of the outer classes (RenderType/RenderStateShard)
# (the former public, the latter protected), and javac resolves using the latter, so
# without this gate they can't be referenced from other packages (NeoForge/Forge have ATs that open these two).
accessible class net/minecraft/client/renderer/RenderType$CompositeState
accessible class net/minecraft/client/renderer/RenderStateShard$LineStateShard
